# C++ Core Guidelines are the style rule set; every check of the set is enabled
# (plus the modernize/misc checks below). Nothing is disabled.
Checks: >
  -*,
  cppcoreguidelines-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-loop-convert,
  modernize-use-nodiscard,
  modernize-use-using,
  modernize-make-unique,
  modernize-make-shared,
  misc-throw-by-value-catch-by-reference,
  modernize-macro-to-enum
WarningsAsErrors: ''
# Only this repo's own headers are reported: anchored on the checkout directory name
# (CI checks repos out as siblings under their repo name), so third-party headers
# (Conan ".../include/...") and sibling repos are never linted from here.
HeaderFilterRegex: '.*/openindy-math/(include|src)/.*'
# FormatStyle: file -- format the code produced by clang-tidy's automatic fix-its (--fix)
# with the .clang-format found by walking up from the source file; it does not change
# what is reported.
FormatStyle: file
